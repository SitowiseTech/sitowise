# Sitowise environment (spec section 17). Copy to .env.local and fill in.
# Everything here is read through lib/env.ts. Do not hardcode any of it elsewhere.

# --- required -----------------------------------------------------------------

# Neon connection string.
DATABASE_URL=postgresql://user:password@host.neon.tech/sitowise?sslmode=require

# Session cookie HMAC key. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Signs withdrawal vouchers. Holds no funds and never sends a transaction.
SIGNER_PRIVATE_KEY=

# Deployed SitowiseFactory. Public: it is inlined into the client bundle.
NEXT_PUBLIC_FACTORY=

# Receives node payments. The contract forwards the mint price here immediately.
TREASURY_ADDRESS=

# Sent as the x-admin-key header to reach /admin.
ADMIN_KEY=

# Signs SitowiseFactory.creditBatch. Must be the address the contract stores as
# `distributor`, and it holds the payout float: creditBatch is payable, so this
# one balance pays both the credited amounts and the gas.
DISTRIBUTOR_PRIVATE_KEY=

# Sent as the x-cron-key header to start a scheduled pass (/api/cron/*).
# Deliberately not ADMIN_KEY: a cron service stores its key forever in someone
# else's configuration. Generate with: openssl rand -hex 32
CRON_KEY=


# ---------------------------------------------------------------- watcher
# Payment discovery goes through the Blockscout address index, not through
# block reads; see "How payments are found" in the README. Every one of these
# has a working default, so an empty section is a valid deployment.
#
# The most cursor one unattended pass may claim. Discovery answers for a range
# of any size in one request, so this is not a cost limit — it is the point at
# which closing a gap becomes a human decision (see the fast-forward route).
# WATCHER_MAX_CATCHUP_BLOCKS=10000
#
# Ceiling on the RPC block-read fallback, which only runs when the explorer is
# unreachable. Block reads are slower than the chain produces blocks, so this
# rides out a blip and nothing more. 0 switches the fallback off.
# WATCHER_MAX_BLOCKS_PER_PASS=200
#
# Explorer paging and per-request timeout. Each request is retried twice.
# WATCHER_EXPLORER_PAGE_SIZE=100
# WATCHER_EXPLORER_MAX_PAGES=10
# WATCHER_EXPLORER_TIMEOUT_MS=5000

# --- optional -----------------------------------------------------------------

# Deployed SitowiseHook. Only used to list the address on /docs/addresses; the
# page shows "Not deployed yet" while it is unset, which is the honest state
# until pools are initialised naming the hook.
# NEXT_PUBLIC_HOOK=

# Robinhood Chain. Only set these to override the compiled-in defaults.
NEXT_PUBLIC_CHAIN_ID=4663
# NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- credit worker (section 8.3) ----------------------------------------------
# Values shown are the defaults applied when the variable is absent.

DIST_ENABLED=true

# treasury credits from the distributor float. swaps has no chain source since
# the hook was removed; setting it makes every pass refuse, on purpose.
DIST_MODE=treasury

# How long ONE node waits between its own credits. Each node draws its own
# delay in this window, which is what keeps the nodes from paying in lockstep.
DIST_MIN_DELAY_SEC=60
DIST_MAX_DELAY_SEC=180

# How often a pass looks for nodes whose wait is over. Keep it no longer than
# DIST_MIN_DELAY_SEC, or timers are routinely overdue by the difference.
DIST_TICK_SEC=60

# What one node is credited, drawn separately per node. Wei, so the value cannot
# change meaning by passing through a float. (DIST_MIN_AMOUNT_ETH still works as
# a fallback; the wei form wins when both are set.)
DIST_MIN_AMOUNT_WEI=2000000000000
DIST_MAX_AMOUNT_WEI=10000000000000

# Safety fuse, not an operating limit: the worker stops once it has credited
# this much in a rolling 24 hours. Raise it deliberately as the node count grows.
DIST_DAILY_CAP_WEI=1000000000000000000

# --- site shell (lib/site.ts) -------------------------------------------------

# Absolute origin for metadata, canonical URLs and the OG card. Falls back to
# the Vercel deployment URL, then to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://sitowise.xyz

# Profile linked from the header and footer icons.
# NEXT_PUBLIC_X_URL=https://x.com/sitowise

# --- credit worker: process-only settings -------------------------------------
# Read by `npm run worker`. The scheduled route reads the same DIST_* values
# above, so there is nothing extra to set to run from cron instead.
#
# Everything the worker needs beyond those is already in this file:
#   DISTRIBUTOR_PRIVATE_KEY  signs creditBatch and holds the payout float
#   CRON_KEY                 gates POST/GET /api/cron/credit
#   DATABASE_URL             the schedule, the ledger and the advisory lock
